<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.quiet.listen"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="30" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.quiet.permission.PREFS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets Mote and Pip dance to the song: the system output mix via Visualizer, never the mic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <queries>
        <package android:name="com.quiet.home" />  <!-- home's shared prefs (Prefs): Android 11 hides other apps otherwise -->
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@style/Quiet"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".Main"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- How home's LISTEN shelf starts something playing: only Quiet apps may come in this way. -->
        <activity-alias
            android:name=".FromHome"
            android:targetActivity=".Main"
            android:exported="true"
            android:permission="com.quiet.permission.PREFS" />
        <service
            android:name=".Playback"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Home's shelf for this app (Quiet apps only). -->
        <provider
            android:name=".ShelfProvider"
            android:authorities="com.quiet.listen.shelf"
            android:exported="true"
            android:readPermission="com.quiet.permission.PREFS"
            android:writePermission="com.quiet.permission.PREFS" />
    </application>
</manifest>
